# Scrubbed template — copy to .env.local and fill in real values:
#   cp .env.local.example .env.local
# Never put a real credential in this file; it is tracked in git.

# Neon Postgres
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Clerk Auth — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# OpenRouter — https://openrouter.ai (used by Vercel AI SDK via OpenAI-compatible client)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Resend — https://resend.com
RESEND_API_KEY=re_...
# Optional — defaults to `Aigenic <agent@notifications.aigenic.app>` if unset.
# ⚠ The from-address DOMAIN must be verified in Resend (Domains → Add Domain →
# DNS records → Verified) or Resend rejects EVERY escalation email — silently
# from the visitor's point of view. Undelivered escalations show up as an
# amber "pending delivery" badge on the site's Conversations tab and are
# retried by the `retry-escalation-emails` Trigger.dev task.
RESEND_FROM_ADDRESS=Aigenic <agent@yourdomain.com>

# Trigger.dev — https://trigger.dev
# The SDK reads TRIGGER_SECRET_KEY; TRIGGER_API_KEY is accepted as a legacy alias.
TRIGGER_PROJECT_REF=proj_...
TRIGGER_SECRET_KEY=tr_dev_...
TRIGGER_API_KEY=
# Optional — only for self-hosted Trigger.dev instances.
TRIGGER_API_URL=

# Stripe — https://dashboard.stripe.com (optional; the Free plan works without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Self-hosted KB scraper service — must match the scraper's SCRAPER_API_KEY
SCRAPER_API_URL=http://localhost:3007
SCRAPER_API_KEY=
# The VPS's public IP. Optional: shown in the dashboard's "your firewall
# blocked our crawler" panel so site owners can allowlist it alongside the
# AigenicBot User-Agent.
SCRAPER_EGRESS_IP=

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000
