{
  "name": "agent-desk",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter aigenic-app dev",
    "build": "pnpm --filter aigenic-widget build && pnpm --filter aigenic-app build && pnpm --dir vps-scraper build",
    "typecheck": "pnpm -r typecheck && pnpm --dir vps-scraper typecheck && tsc -p tests --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
