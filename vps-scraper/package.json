{
  "name": "aigenic-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "VPS-hosted Playwright crawler for Aigenic. Crawls a tenant site and streams clean article content back via webhook.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:local": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsdom": "^29.1.1",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "html-encoding-sniffer": "^4.0.0"
    }
  }
}
