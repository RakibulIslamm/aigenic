{
  "name": "aigenic-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "VPS-hosted Playwright crawler for Aigenic. Crawls a tenant site and streams clean article content back via webhook.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:local": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@mozilla/readability": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsdom": "latest",
    "p-limit": "latest",
    "pino": "latest",
    "pino-pretty": "latest",
    "playwright": "latest",
    "robots-parser": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/jsdom": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "pnpm": {
    "overrides": {
      "html-encoding-sniffer": "^4.0.0"
    }
  }
}
