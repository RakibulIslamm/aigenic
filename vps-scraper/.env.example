# Required — must match SCRAPER_API_KEY in the AgentDesk Next.js app.
SCRAPER_API_KEY=test

# Optional — overrides the default User-Agent the crawler sends.
# SCRAPER_USER_AGENT=AgentDeskBot/0.1 (+https://agentdesk.app/bot)

# Optional — pino log level (trace | debug | info | warn | error | fatal).
# LOG_LEVEL=info

# Optional — the port Express listens on inside the container.
# PORT=3001
