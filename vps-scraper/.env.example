# Required — must match SCRAPER_API_KEY in the Aigenic Next.js app.
SCRAPER_API_KEY=

# Optional — overrides the default User-Agent (desktop Chrome + AigenicBot/1.0,
# see src/identity.ts). Keep the AigenicBot token if you change it.
# SCRAPER_USER_AGENT=

# Optional — Sentry DSN for error tracking. Empty = off. Use a separate Sentry
# project from the web app so crawler errors are easy to tell apart.
# SENTRY_DSN=

# Optional — pino log level (trace | debug | info | warn | error | fatal).
# LOG_LEVEL=info

# Optional — the port Express listens on inside the container.
# PORT=3007
